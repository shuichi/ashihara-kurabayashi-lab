{
  "name": "ashihara-kurabayashi-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/check-build.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "start": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "node --test tests/*.test.mjs",
    "lint": "oxlint app components lib src scripts tests",
    "format": "oxfmt",
    "test:browser": "playwright test",
    "test:performance": "node scripts/measure-performance.mjs",
    "prebuild": "node scripts/content-validation.mjs",
    "preview:static": "node scripts/serve-static.mjs"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "astro": "7.3.1",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "cheerio": "1.2.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.76.0",
    "sharp": "0.35.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
