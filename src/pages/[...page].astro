---
import { getCollection, getEntry, render } from 'astro:content';
import { getImage } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import HomeMotion from '../components/HomeMotion.astro';
import Document from '../layouts/Document.astro';
import SitePage from '../../components/site-page';
import { languages, pagePaths,  } from '../../lib/navigation';
import { navigation } from '../../app/navigation';
import ashihara from '../../assets/profile-ashihara.png';
import kurabayashi from '../../assets/profile-kurabayashi.png';
import campusOverview from '../../assets/activities/open-campus-overview.jpg';
import campusTalk from '../../assets/activities/open-campus-talk.jpg';
import campusSpeaker from '../../assets/activities/open-campus-speaker.jpg';
import summit from '../../assets/activities/ucsd-genai-summit-2025.jpg';
import encyclopedia from '../../assets/activities/encyclopedia-computer-graphics-games.jpg';
import type { PhotoId } from '../../app/photography';
export const getStaticPaths = (async () => {
  await Promise.all([getCollection('home'), getCollection('research'), getCollection('people'), getCollection('publications'), getCollection('students'), getCollection('common'), getCollection('pages'), getCollection('navigation'), getCollection('bibliography'), getCollection('about'), getCollection('news'), getCollection('photography')]);
  return languages.flatMap(language => pagePaths.map(pathname => ({
    params: { page: [language === 'en' ? 'en' : '', pathname.slice(1)].filter(Boolean).join('/') || undefined },
    props: { language, pathname },
  })));
}) satisfies GetStaticPaths;
const { language, pathname } = Astro.props;
const info = navigation[language].find(page => page.href === pathname)!;
const name = language === 'ja' ? '芦原・倉林研究室 | 東京理科大学' : 'Ashihara-Kurabayashi Lab. | Tokyo University of Science';
const title = pathname === '/' ? name : `${info.label} | ${name}`;
const about = pathname === '/' ? await getEntry('about', language) : undefined;
const renderedAbout = about ? await render(about) : undefined;
const About = renderedAbout?.Content;
const portraits = Object.fromEntries(await Promise.all(
  (pathname === '/people' ? [['ashihara@rs.tus.ac.jp', ashihara], ['shuichi@rs.tus.ac.jp', kurabayashi]] as const : []).map(async ([email, src]) => {
    const [webp, avif] = await Promise.all([getImage({ src, format: 'webp', width: 510, quality: 80 }), getImage({ src, format: 'avif', width: 510, quality: 65 })]);
    return [email, { src: webp.src, webp: webp.src, avif: avif.src, width: 255, height: 312 }];
  }),
));
const photoSources = { campusOverview, campusTalk, campusSpeaker, summit, encyclopedia };
const pagePhotos: Partial<Record<typeof pathname, PhotoId[]>> = {
  '/': ['campusSpeaker', 'summit', 'encyclopedia'],
  '/students': ['campusOverview', 'campusTalk', 'campusSpeaker'],
  '/people': ['summit'],
  '/publications': ['encyclopedia'],
};
const photos = Object.fromEntries(await Promise.all((pagePhotos[pathname] ?? []).map(async (id) => {
  const src = photoSources[id];
  const variants = await Promise.all([640, 1280, 1920].map(async (width) => {
    const [webp, avif] = await Promise.all([
      getImage({ src, format: 'webp', width, quality: 80 }),
      getImage({ src, format: 'avif', width, quality: 60 }),
    ]);
    return { width, webp: webp.src, avif: avif.src };
  }));
  return [id, {
    src: variants[1].webp,
    webp: variants.map(image => `${image.webp} ${image.width}w`).join(', '),
    avif: variants.map(image => `${image.avif} ${image.width}w`).join(', '),
    width: src.width,
    height: src.height,
  }];
})));
---
<Document language={language} pathname={pathname} title={title} description={info.description}>
  <SitePage language={language} pathname={pathname} base={import.meta.env.BASE_URL} portraits={portraits} photos={photos}>{About && <About slot="about" />}</SitePage>
  {pathname === '/' && <HomeMotion />}
</Document>
